# ==== Web ====
APP_NAME=TG Drive
HOST=127.0.0.1
PORT=8787
APP_PASSWORD=replace-with-a-long-password
APP_SECRET=replace-with-a-random-string-at-least-32-chars
COOKIE_SECURE=false

# ==== Telegram ====
# user = Telegram account session (large files, personal use)
# bot  = bot token (safer for automation, add bot as channel admin)
TG_MODE=user
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
TG_CHAT_ID=
# Optional. Auto-detects the Windows/environment proxy if omitted.
# Example: socks5://127.0.0.1:7892
TG_PROXY=socks5://127.0.0.1:7892

# Session path. Never commit this file.
TG_SESSION=data/tgdrive

# One Telegram message segment. Normal accounts: 2 GB per-file limit.
TG_SEGMENT_SIZE=1800000000

# Browser upload chunk size, 8 MB
UPLOAD_CHUNK_SIZE=8388608

# 0 = unlimited
MAX_FILE_SIZE=0
