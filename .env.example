# ==== 运行环境 ====
APP_NAME=TG Drive
APP_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO
# 生产容器中建议开启 JSON 日志
LOG_JSON=false
# 前端构建产物目录；本地默认 static/dist
FRONTEND_DIST=static/dist

# ==== 安全 ====
APP_PASSWORD=replace-with-a-long-password
# 生产环境必须至少 32 位
APP_SECRET=replace-with-a-random-string-at-least-32-chars
COOKIE_SECURE=false
SESSION_MAX_AGE=1209600
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ==== Telegram ====
# user = Telegram account session (large files, personal use)
# bot  = bot token (safer for automation, add bot as channel admin)
TG_MODE=user
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
# Optional dedicated HTTP Bot API token for fallback when the user session is offline.
TG_BOT_FALLBACK_TOKEN=
TG_CHAT_ID=
# Optional. Auto-detects the Windows/environment proxy if omitted.
# Example: socks5://127.0.0.1:1080
TG_PROXY=

# Session path (Telethon appends .session). Never commit this file.
TG_SESSION=data/tgdrive

# One Telegram message segment. Normal accounts: 2 GB per-file limit.
TG_SEGMENT_SIZE=1800000000

# Browser upload chunk size, 8 MB
UPLOAD_CHUNK_SIZE=8388608
# 同时写入 Telegram 的最大任务数
UPLOAD_CONCURRENCY=2

# 0 = unlimited
MAX_FILE_SIZE=0
# 未完成上传保留时长；运行期间每 5 分钟清理，0 表示不自动清理
UPLOAD_STALE_HOURS=72
# 上传临时目录总额度（MiB），涵盖所有工作区的上传分片，0 表示不设额度
UPLOAD_TEMP_MAX_MIB=51200
# 写入后磁盘至少保留的空间（MiB）
UPLOAD_TEMP_MIN_FREE_MIB=512

# 私有视频 Range 服务端缓存。0 关闭，容量和保留空间均以 MiB 为单位。
MEDIA_CACHE_MAX_MIB=0
MEDIA_CACHE_MIN_FREE_MIB=4096
# 可选，默认 DATA_DIR/media-slices。独立目录可与元数据备份分开。
MEDIA_CACHE_DIR=

# ==== 部署（docker compose）====
DOMAIN=drive.example.com
ACME_EMAIL=admin@example.com

# 频道同步：实时监听 + 定时补同步，启动时自动扫描历史
CHANNEL_SYNC_ENABLED=true
CHANNEL_SYNC_INTERVAL=30

# Optional AI enrichment for new/edited video captions. Use an HTTPS /v1 base.
PEOPLE_AI_BASE_URL=
PEOPLE_AI_MODEL=
PEOPLE_AI_API_KEY=

# 宿主机采集文件；默认每天 100GB，入站+出站，北京时间 00:00 重置。
# Docker 自动使用 /host-traffic/host.json；先在 VPS 执行 deploy/install-traffic.sh。
TRAFFIC_HOST_STATE=data/traffic/host.json

# AxisNow CDN 月流量：服务端只读查询，设置令牌后自动启用保护。
AXISNOW_API_TOKEN=
# 留空监控所有有效订阅；可填订阅 UUID，英文逗号分隔。
AXISNOW_SUBSCRIPTION_IDS=
CDN_WARNING_PERCENT=80
CDN_STOP_PERCENT=95
