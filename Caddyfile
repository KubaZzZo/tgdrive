# TG Drive 反向代理；可放在 Cloudflare 橙云后，SSL 使用 Full (strict)。
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format console
		level ERROR
	}
}

{$DOMAIN} {
	# 兼容直连上传；Cloudflare 仍有独立的单请求大小限制。
	request_body {
		max_size 4.5GB
	}

	reverse_proxy app:8787 {
		# Caddy 默认不缓冲完整请求/响应；即时转发 Range 媒体流。
		flush_interval -1
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
			keepalive_idle_conns 32
		}
	}

	# encode 默认按响应 MIME 筛选；媒体路径额外排除以保留 Range 语义。
	@compressible {
		not path /api/files/* /api/uploads/*/events /api/video-import/*/events /s/* /i/* /webdav /webdav/*
	}
	encode @compressible zstd gzip

	# Vite 产物文件名带内容哈希，可长期缓存。
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# 分享撤销/过期必须回源检查。defer 覆盖上游的 public 缓存头。
	@private {
		path /api /api/* /s /s/* /i/* /webdav /webdav/*
		not path_regexp ^/api/files/[^/]+/thumbnail$
	}
	header @private {
		Cache-Control "private, no-store"
		Cloudflare-CDN-Cache-Control "no-store"
		defer
	}
	@thumbnail path_regexp ^/api/files/[^/]+/thumbnail$
	header @thumbnail {
		?Cache-Control "private, no-store"
		Cloudflare-CDN-Cache-Control "no-store"
		defer
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	# 分享路径和 WebDAV 路径含有私有信息。
	@privateLog path /s/* /i/* /webdav/*
	log_skip @privateLog

	log {
		output stdout
		format json
		level INFO
	}
}
